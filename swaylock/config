daemonize
#show-keyboard-layout
#ignore-empty-password
indicator-caps-lock
#image=$XDG_CONFIG_HOME/swaylock/Turntable-1200-above.jpg
image=$XDG_CONFIG_HOME/swaylock/Turntable-1200-above-black-background.jpg
scaling=fit

# Line just between tracks
#indicator-radius=286
indicator-radius=160
indicator-thickness=4
#indicator-x-position=878
indicator-x-position=880
#indicator-y-position=624
indicator-y-position=631

#font=SuperFunky
#font-size=96
#font=etna
font=Ailerons
#font=aqua
#font=trade-gothic

# Caps Lock
caps-lock-bs-hl-color=878787
caps-lock-key-hl-color=71797e
inside-caps-lock-color=87878760
#ring-caps-lock-color=71797e
text-caps-lock-color=000000

# Verify
ring-ver-color=cdc6efff
inside-ver-color=cdc6ef00

# Wrong
inside-wrong-color=80000050

# Backspace`
bs-hl-color=C0C0C0

# Clear
ring-clear-color=C0C0C040
line-clear-color=C0C0C0
inside-clear-color=C0C0C040

# Typing
key-hl-color=cdc6efff
inside-color=ffffff00
ring-color=00000000
separator-color=00000000
line-uses-inside

# Background
color=FFFFFF00


indicator-idle-visible
